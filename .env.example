# Bottleneck: Time in Status & SLAs
# monday.com Marketplace App Environment Variables

# Node Environment
NODE_ENV=development
PORT=8080

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=bottleneck_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/bottleneck_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# monday.com API & App Credentials
# Found in monday Developer Center -> App Features -> OAuth & Permissions / Webhooks
MONDAY_SIGNING_SECRET=your_monday_signing_secret_here
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_CLIENT_ID=your_monday_client_id_here
MONDAY_CLIENT_SECRET=your_monday_client_secret_here

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
